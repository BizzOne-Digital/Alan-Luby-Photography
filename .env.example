# Backend API base URL (see ../backend). Only public values belong here: everything VITE_* ends up in the browser.
#   Local development:   VITE_API_URL=/api            (the dev server proxies /api to http://localhost:5000)
#                    or: VITE_API_URL=http://localhost:5000/api
#   Production:          VITE_API_URL=/api            with a Vercel rewrite of /api/* to your backend (recommended),
#                    or: VITE_API_URL=https://your-backend.example.com/api
# Leave empty to run the site on its built-in content only (no admin, no stored inquiries).
VITE_API_URL=

# Optional, only used when VITE_API_URL is empty: send contact-form inquiries to a form service instead of composing an email.
# Formspree:  VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
# Web3Forms:  VITE_FORM_ENDPOINT=https://api.web3forms.com/submit  plus  VITE_FORM_ACCESS_KEY=your-access-key
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
